# Only needed if running examples
OPENROUTER_API_KEY=
PRIVATE_KEY=

# EVM RPC (optional) - falls back to public endpoints, which are rate limited.
# Set your own for anything beyond casual use. Either give one list:
#   RPC_URLS=1=https://…,8453=https://…
# or set them individually. RPC_URL_<chainId> also works for any chain.
RPC_URLS=
ETHEREUM_RPC_URL=
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
MODE_RPC_URL=
SEPOLIA_RPC_URL=

# Solana (optional) - reads work without any of these
SOLANA_PRIVATE_KEY=
SOLANA_ACCOUNT=
SOLANA_RPC_URL=
# Optional; keyless tier is available at a lower rate limit.
JUPITER_API_KEY=

# Optional API keys - only required if using specific tool collections
DRPC_KEY=
PERPLEXITY_API_KEY=
ZEROX_API_KEY=
BLOCKSCOUT_API_KEY=
TALLY_API_KEY=
COINDESK_API_KEY=
COINMARKETCAL_API_KEY=
PINATA_JWT=
FIREWORKS_API_KEY=
X_BEARER_TOKEN=
X_API_KEY=
X_API_KEY_SECRET=
